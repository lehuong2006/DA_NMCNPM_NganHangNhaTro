@model BTL_NganHangNhaTro.Models.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <div class="login-container">

        <div class="login-header">
            Nhà trọ số 8 Nguyễn An Ninh
        </div>

        <div class="login-content">

            <h2>Đăng nhập</h2>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <!-- Số điện thoại -->
                <div class="form-group">
                    <label asp-for="PhoneNumber">
                        <span class="field-icon"></span>
                        Số điện thoại
                    </label>

                    <input asp-for="PhoneNumber"
                           type="tel"
                           id="phoneNumber"
                           placeholder="Nhập số điện thoại"
                           autocomplete="tel">

                    <span asp-validation-for="PhoneNumber"
                          class="validation-message"></span>
                </div>

                <!-- Mật khẩu -->
                <div class="form-group">
                    <label asp-for="Password">
                        <span class="field-icon"></span>
                        Mật khẩu
                    </label>

                    <div class="password-wrapper">
                        <input asp-for="Password"
                               type="password"
                               id="password"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password">

                        <button type="button"
                                class="toggle-password"
                                onclick="togglePassword()">
                        </button>
                    </div>

                    <span asp-validation-for="Password"
                          class="validation-message"></span>
                </div>

                <!-- Ghi nhớ đăng nhập -->
                <div class="form-group remember-me">
                    <label>
                        <input asp-for="RememberMe" type="checkbox">
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <!-- Nút đăng nhập -->
                <button type="submit" class="login-button">
                    Đăng nhập
                </button>

            </form>

            <!-- Liên kết đăng ký -->
            <div class="register-link">
                Chưa có tài khoản?
                <a href="/Account/Register">Đăng ký</a>
            </div>

        </div>
    </div>

    <script src="~/js/login.js"></script>

</body>
</html>
