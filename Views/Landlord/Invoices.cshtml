@model IEnumerable<BTL_NganHangNhaTro.Models.Invoice>
@{
    Layout = null;
    ViewData["Title"] = "Hóa đơn hàng tháng";
    var activeContracts = ViewBag.ActiveContracts as IEnumerable<BTL_NganHangNhaTro.Models.Contract> ?? Enumerable.Empty<BTL_NganHangNhaTro.Models.Contract>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/landlord-dashboard.css" />
    <link rel="stylesheet" href="~/css/landlord-invoices.css" />
    <style>
        .invoice-actions-top {
            display: flex;
            gap: 10px;
        }
        .btn-create-invoice {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 16px;
            background-color: #176b5d;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            transition: background-color 0.2s;
        }
        .btn-create-invoice:hover {
            background-color: #105448;
        }
        /* Modal tạo hóa đơn cho phòng */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.45);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.active {
            display: flex;
        }
        .modal-dialog {
            background: #fff;
            border-radius: 8px;
            width: 480px;
            max-width: 92%;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            border-bottom: 1px solid #e5ede9;
            background: #f7faf8;
        }
        .modal-header h3 {
            margin: 0;
            font-size: 16px;
            color: #176b5d;
        }
        .modal-close-btn {
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: #888;
        }
        .modal-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .modal-footer {
            padding: 14px 20px;
            border-top: 1px solid #e5ede9;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            background: #f7faf8;
        }
        .form-row-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .form-row-group label {
            font-size: 12px;
            font-weight: 600;
            color: #35463f;
        }
        .form-row-group input, .form-row-group select {
            padding: 8px 10px;
            border: 1px solid #d5dfda;
            border-radius: 5px;
            font-size: 13px;
        }
        .form-row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
    </style>
</head>
<body>

    <div class="dashboard-layout">

        <!-- Thanh điều hướng -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>Ngân hàng nhà trọ</h2>
                <p>Nhà trọ số 8 Nguyễn An Ninh</p>
            </div>

            <nav class="sidebar-nav">

                <a href="/Landlord/Dashboard" class="nav-item">
                    <span></span>
                    Tổng quan
                </a>

                <a href="/Landlord/Rooms" class="nav-item">
                    <span></span>
                    Phòng
                </a>

                <a href="/Landlord/Tenants" class="nav-item">
                    <span></span>
                    Người thuê
                </a>

                <a href="/Landlord/ContractForm" class="nav-item">
                    <span></span>
                    Hợp đồng
                </a>

                <a href="/Landlord/Invoices" class="nav-item active">
                    <span></span>
                    Hóa đơn
                </a>

                <a href="/Landlord/WalletTransactions" class="nav-item">
                    <span></span>
                    Giao dịch ví
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-role">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Chủ trọ")</div>

                <a href="/Account/Logout" class="logout-button">
                    <span></span>
                    Đăng xuất
                </a>
            </div>

        </aside>


        <!-- Nội dung chính -->
        <main class="main-content invoices-content">

            <div class="invoice-page-header">

                <div class="page-header">
                    <h1>Hóa đơn hàng tháng</h1>
                    <p>Theo dõi hóa đơn từng phòng, xác nhận thanh toán và in phiếu thu</p>
                </div>

                <div class="invoice-actions-top">
                    <button type="button" class="btn-create-invoice" id="openCreateInvoiceModalBtn">
                        + Tạo hóa đơn cho phòng
                    </button>
                    <a href="/Landlord/MeterReading" class="meter-reading-button">
                        Nhập chỉ số điện nước
                    </a>
                </div>

            </div>


            <!-- Thống kê hóa đơn -->
            <section class="invoice-statistics">

                <div class="invoice-stat-card">
                    <p>Số hóa đơn trong kỳ</p>
                    <h2>@(ViewBag.TotalCount ?? 0)</h2>
                </div>

                <div class="invoice-stat-card">
                    <p>Đã thu (VNĐ)</p>
                    <h2>@(((long)(ViewBag.PaidAmount ?? 0)).ToString("N0"))</h2>
                </div>

                <div class="invoice-stat-card">
                    <p>Còn phải thu (VNĐ)</p>
                    <h2>@(((long)(ViewBag.RemainingAmount ?? 0)).ToString("N0"))</h2>
                </div>

            </section>


            <!-- Khu vực danh sách và phiếu thu -->
            <section class="invoice-main-grid">

                <!-- Bên trái -->
                <div class="invoice-list-section">

                    <!-- Bộ lọc -->
                    <div class="invoice-filters">

                        <div class="filter-group">
                            <label for="billingPeriod">Kỳ hóa đơn</label>
                            <input type="month" id="billingPeriod">
                        </div>

                        <div class="filter-group">
                            <label for="invoiceStatus">Trạng thái</label>
                            <select id="invoiceStatus">
                                <option value="">Tất cả</option>
                                <option value="unpaid">Chưa thanh toán</option>
                                <option value="paid">Đã thanh toán</option>
                                <option value="partial">Còn nợ</option>
                            </select>
                        </div>

                        <div class="filter-group search-filter">
                            <label for="invoiceSearch">Tìm phòng hoặc khách thuê</label>
                            <input type="text"
                                   id="invoiceSearch"
                                   placeholder="Ví dụ: P101">
                        </div>

                    </div>


                    <!-- Bảng hóa đơn -->
                    <div class="invoice-table-panel">

                        <div class="table-wrapper">

                            <table class="invoice-table">

                                <thead>
                                    <tr>
                                        <th>Phòng</th>
                                        <th>Khách thuê</th>
                                        <th>Tổng tiền</th>
                                        <th>Còn lại</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>

                                <tbody id="invoiceTableBody">
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var inv in Model)
                                        {
                                            var roomCode = inv.Room?.RoomCode ?? "P" + inv.RoomId;
                                            var tenantName = inv.Contract?.Tenant?.FullName ?? "Khách thuê";
                                            var statusCls = inv.Status.ToLower();
                                            var statusText = inv.Status == "PAID" ? "Đã thanh toán" : (inv.Status == "PARTIAL" ? "Còn nợ" : "Chưa thanh toán");

                                            <tr class="invoice-row" 
                                                data-room="@roomCode"
                                                data-tenant="@tenantName"
                                                data-period="@inv.MonthYear"
                                                data-status="@statusCls"
                                                data-code="@inv.InvoiceCode"
                                                data-created-date="@inv.CreatedAt.ToString("yyyy-MM-dd")"
                                                data-due-date="@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("yyyy-MM-dd") : "")"
                                                data-total="@inv.TotalAmount"
                                                data-amount-words="@(inv.TotalAmount.ToString("N0") + " đồng")">
                                                <td><strong>@roomCode</strong></td>
                                                <td>@tenantName</td>
                                                <td>@inv.TotalAmount.ToString("N0") đ</td>
                                                <td>@inv.RemainingAmount.ToString("N0") đ</td>
                                                <td>
                                                    <span class="invoice-status @statusCls">@statusText</span>
                                                </td>
                                                <td>
                                                    <button type="button" class="invoice-action-button">Xem</button>
                                                </td>
                                                <td style="display:none;">
                                                    @if (inv.InvoiceItems != null && inv.InvoiceItems.Any())
                                                    {
                                                        foreach (var item in inv.InvoiceItems)
                                                        {
                                                            <div class="invoice-item-data" data-name="@item.ItemName" data-amount="@item.Amount"></div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="invoice-item-data" data-name="Tiền phòng" data-amount="@inv.RoomFee"></div>
                                                        @if (inv.ElecFee > 0)
                                                        {
                                                            <div class="invoice-item-data" data-name="Tiền điện" data-amount="@inv.ElecFee"></div>
                                                        }
                                                        @if (inv.WaterFee > 0)
                                                        {
                                                            <div class="invoice-item-data" data-name="Tiền nước" data-amount="@inv.WaterFee"></div>
                                                        }
                                                        @if (inv.ServiceFee > 0)
                                                        {
                                                            <div class="invoice-item-data" data-name="Dịch vụ khác" data-amount="@inv.ServiceFee"></div>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>

                            </table>

                            <div class="invoice-empty" style="@(Model != null && Model.Any() ? "display:none;" : "display:flex;")">
                                Chưa có dữ liệu hóa đơn.
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Bên phải: Xem trước phiếu thu -->
                <div class="receipt-preview-panel">

                    <div class="receipt-preview-header">
                        <h3>Phiếu thu</h3>
                        <span class="preview-status">Chưa chọn</span>
                    </div>

                    <div class="receipt-paper">

                        <div class="receipt-heading">

                            <div>
                                <strong>NHÀ TRỌ SỐ 8 NGUYỄN AN NINH</strong>
                                <p>Địa chỉ: Số 8 Nguyễn An Ninh, Hà Nội</p>
                            </div>

                            <div class="receipt-code">
                                <span>Mã HĐ</span>
                                <strong id="previewInvoiceCode">—</strong>

                                <span>Ngày lập</span>
                                <strong id="previewCreatedDate">—</strong>
                            </div>

                        </div>


                        <div class="receipt-title">
                            <h2>PHIẾU THU TIỀN TRỌ</h2>
                            <p>Kỳ thanh toán: <span id="previewBillingPeriod">—</span></p>
                        </div>


                        <div class="receipt-tenant-information">

                            <div>
                                <span>Khách thuê:</span>
                                <strong id="previewTenant">—</strong>
                            </div>

                            <div>
                                <span>Phòng:</span>
                                <strong id="previewRoom">—</strong>
                            </div>

                            <div>
                                <span>Hạn thanh toán:</span>
                                <strong id="previewDueDate">—</strong>
                            </div>

                        </div>


                        <div class="receipt-items" id="receiptItems">
                            <div class="receipt-item-empty">
                                Chọn một hóa đơn để xem chi tiết.
                            </div>
                        </div>


                        <div class="receipt-grand-total">
                            <strong>Tổng cộng (VNĐ)</strong>
                            <strong id="previewTotal">0</strong>
                        </div>

                        <p class="receipt-amount-words">
                            Bằng chữ: <span id="previewAmountWords">—</span>
                        </p>


                        <div class="receipt-signatures">

                            <div>
                                <strong>Người nộp tiền</strong>
                                <span>(Ký ghi rõ họ tên)</span>
                            </div>

                            <div>
                                <strong>Chủ trọ</strong>
                                <span>(Ký ghi rõ họ tên)</span>
                            </div>

                        </div>


                        <div class="receipt-actions">

                            <button type="button"
                                    class="print-receipt-button"
                                    id="printReceiptButton">
                                In phiếu thu
                            </button>

                            <button type="button"
                                    class="download-pdf-button"
                                    id="downloadPdfButton">
                                Tải PDF
                            </button>

                        </div>

                    </div>

                </div>

            </section>

        </main>

    </div>

    <!-- MODAL TẠO HÓA ĐƠN THEO PHÒNG -->
    <div class="modal-overlay" id="createInvoiceModal">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Tạo hóa đơn cho phòng</h3>
                <button type="button" class="modal-close-btn" id="closeCreateInvoiceModalBtn">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-row-group">
                    <label for="modalRoomSelect">Chọn phòng đang thuê *</label>
                    <select id="modalRoomSelect" required>
                        <option value="">-- Chọn phòng để tạo hóa đơn --</option>
                        @foreach (var c in activeContracts)
                        {
                            <option value="@c.RoomId" data-price="@c.RentalPrice" data-tenant="@(c.Tenant?.FullName ?? "")">
                                @(c.Room?.RoomCode ?? "P" + c.RoomId) - Khách: @(c.Tenant?.FullName ?? "Chưa rõ") (Tiền thuê: @c.RentalPrice.ToString("N0") đ)
                            </option>
                        }
                    </select>
                </div>

                <div class="form-row-2col">
                    <div class="form-row-group">
                        <label for="modalMonthYear">Kỳ hóa đơn (tháng/năm) *</label>
                        <input type="month" id="modalMonthYear" value="@DateTime.Now.ToString("yyyy-MM")">
                    </div>
                    <div class="form-row-group">
                        <label for="modalDueDate">Hạn nộp</label>
                        <input type="date" id="modalDueDate" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <div class="form-row-2col">
                    <div class="form-row-group">
                        <label for="modalRoomFee">Tiền phòng (VNĐ) *</label>
                        <input type="text" id="modalRoomFee" placeholder="Nhập tiền phòng">
                    </div>
                    <div class="form-row-group">
                        <label for="modalElecFee">Tiền điện (VNĐ)</label>
                        <input type="text" id="modalElecFee" placeholder="0">
                    </div>
                </div>

                <div class="form-row-2col">
                    <div class="form-row-group">
                        <label for="modalWaterFee">Tiền nước (VNĐ)</label>
                        <input type="text" id="modalWaterFee" placeholder="0">
                    </div>
                    <div class="form-row-group">
                        <label for="modalServiceFee">Dịch vụ khác (VNĐ)</label>
                        <input type="text" id="modalServiceFee" placeholder="0">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="invoice-action-button" id="cancelModalBtn" style="height:34px; padding:0 15px;">Hủy</button>
                <button type="button" class="btn-create-invoice" id="saveInvoiceModalBtn">Tạo hóa đơn</button>
            </div>
        </div>
    </div>

    <script src="~/js/landlord-invoices.js"></script>

</body>
</html>
