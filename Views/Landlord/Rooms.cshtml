@model IEnumerable<BTL_NganHangNhaTro.Models.Room>
@{
    Layout = null;
    ViewData["Title"] = "Danh sách phòng";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <!-- Tái sử dụng CSS Sidebar từ trang Dashboard -->
    <link rel="stylesheet" href="~/css/landlord-dashboard.css" />

    <!-- CSS riêng của trang Danh sách phòng -->
    <link rel="stylesheet" href="~/css/landlord-rooms.css" />
</head>
<body>

    <div class="dashboard-layout">

        <!-- Thanh điều hướng -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>Ngân hàng nhà trọ</h2>
                <p>Nhà trọ số 8 Nguyễn An Ninh</p>
            </div>

            <nav class="sidebar-nav">

                <a href="/Landlord/Dashboard" class="nav-item">
                    <span></span>
                    Tổng quan
                </a>

                <a href="/Landlord/Rooms" class="nav-item active">
                    <span></span>
                    Phòng
                </a>

                <a href="/Landlord/Tenants" class="nav-item">
                    <span></span>
                    Người thuê
                </a>

                <a href="/Landlord/ContractForm" class="nav-item">
                    <span></span>
                    Hợp đồng
                </a>

                <a href="/Landlord/Invoices" class="nav-item">
                    <span></span>
                    Hóa đơn
                </a>

                <a href="/Landlord/WalletTransactions" class="nav-item">
                    <span></span>
                    Giao dịch ví
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-role">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Chủ trọ")</div>

                <a href="/Account/Logout" class="logout-button">
                    <span></span>
                    Đăng xuất
                </a>
            </div>

        </aside>


        <!-- Nội dung chính -->
        <main class="main-content">

            <div class="page-header">
                <h1>Danh sách phòng</h1>
                <p>Quản lý thông tin và tình trạng các phòng trọ</p>
            </div>


            <!-- Thanh tìm kiếm và bộ lọc -->
            <section class="room-toolbar">

                <div class="search-box">
                    <input type="text"
                           id="searchRoom"
                           placeholder="Tìm kiếm phòng..." />
                </div>

                <div class="filter-group">

                    <select id="statusFilter">
                        <option value="">Tất cả trạng thái</option>
                        <option value="available">Trống</option>
                        <option value="rented">Đang thuê</option>
                        <option value="maintenance">Bảo trì</option>
                    </select>

                    <select id="floorFilter">
                        <option value="">Tất cả các tầng</option>
                        <option value="1">Tầng 1</option>
                        <option value="2">Tầng 2</option>
                        <option value="3">Tầng 3</option>
                    </select>

                </div>

                <a href="/Landlord/RoomForm" class="add-room-button">
                    + Thêm phòng
                </a>

            </section>


            <!-- Danh sách phòng -->
            <section class="room-list" id="roomList">

                @if (Model != null && Model.Any())
                {
                    foreach (var room in Model)
                    {
                        var statusCls = room.Status.ToLower();
                        var statusName = room.Status == "RENTED" ? "Đang thuê" : (room.Status == "MAINTENANCE" ? "Bảo trì" : (room.Status == "DEPOSIT" ? "Đã cọc" : "Trống"));
                        var activeContract = room.Contracts.FirstOrDefault(c => c.Status == "ACTIVE");
                        var tenantName = activeContract?.Tenant?.FullName;
                        // Xác định tầng theo tên mã phòng, ví dụ P101 -> 1, P201 -> 2
                        var floor = "1";
                        if (room.RoomCode.Length >= 2 && char.IsDigit(room.RoomCode[1]))
                        {
                            floor = room.RoomCode[1].ToString();
                        }

                        <div class="room-card" 
                             data-name="@room.RoomCode @room.RoomName"
                             data-status="@statusCls"
                             data-floor="@floor">
                            
                            <div class="room-card-header">
                                <h3 class="room-name">@room.RoomCode</h3>
                                <span class="room-status @statusCls">@statusName</span>
                            </div>

                            <div class="room-info">
                                <p><strong>Giá:</strong> @room.Price.ToString("N0") VNĐ/tháng</p>
                                <p><strong>Tối đa:</strong> @room.MaxTenants người</p>
                                @if (!string.IsNullOrEmpty(tenantName))
                                {
                                    <p><strong>Người thuê:</strong> @tenantName</p>
                                }
                                else
                                {
                                    <p style="color:#888;">Chưa có người thuê</p>
                                }
                            </div>

                            <div style="margin-top: 10px; display:flex; gap: 8px; align-items:center;">
                                <a href="/Landlord/RoomForm?id=@room.Id" style="font-size:12px; color:#176b5d; text-decoration:none; font-weight:600;">Sửa</a>
                                @if (room.Status == "AVAILABLE")
                                {
                                    <a href="/Landlord/ContractForm?roomId=@room.Id" style="font-size:12px; color:#237343; text-decoration:none; font-weight:600;">Lập HĐ</a>
                                }
                                @if (activeContract != null)
                                {
                                    <button type="button" 
                                            class="btn-terminate"
                                            data-contract-id="@activeContract.Id"
                                            data-room-id="@room.Id"
                                            data-room-code="@room.RoomCode"
                                            data-tenant-name="@(tenantName ?? "người thuê")"
                                            style="background:none; border:none; padding:0; font-size:12px; color:#dc3545; font-weight:600; cursor:pointer;">
                                        Chấm dứt HĐ
                                    </button>
                                }
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="room-empty">
                        <h3>Chưa có dữ liệu phòng</h3>
                        <p>Danh sách phòng sẽ được hiển thị tại đây.</p>
                    </div>
                }

            </section>

        </main>

    </div>

    <script src="~/js/landlord-rooms.js"></script>

</body>
</html>
