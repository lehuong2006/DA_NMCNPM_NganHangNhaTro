@model IEnumerable<BTL_NganHangNhaTro.Models.Contract>
@{
    Layout = null;
    ViewData["Title"] = "Quản lý người thuê";
    var rooms = ViewBag.Rooms as IEnumerable<BTL_NganHangNhaTro.Models.Room> ?? Enumerable.Empty<BTL_NganHangNhaTro.Models.Room>();
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/landlord-dashboard.css" />
    <link rel="stylesheet" href="~/css/landlord-tenants.css" />
</head>
<body>

    <div class="dashboard-layout">

        <!-- Thanh điều hướng -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>Ngân hàng nhà trọ</h2>
                <p>Nhà trọ số 8 Nguyễn An Ninh</p>
            </div>

            <nav class="sidebar-nav">

                <a href="/Landlord/Dashboard" class="nav-item">
                    <span></span>
                    Tổng quan
                </a>

                <a href="/Landlord/Rooms" class="nav-item">
                    <span></span>
                    Phòng
                </a>

                <a href="/Landlord/Tenants" class="nav-item active">
                    <span></span>
                    Người thuê
                </a>

                <a href="/Landlord/ContractForm" class="nav-item">
                    <span></span>
                    Hợp đồng
                </a>

                <a href="/Landlord/Invoices" class="nav-item">
                    <span></span>
                    Hóa đơn
                </a>

                <a href="/Landlord/WalletTransactions" class="nav-item">
                    <span></span>
                    Giao dịch ví
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-role">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Chủ trọ")</div>

                <a href="/Account/Logout" class="logout-button">
                    <span></span>
                    Đăng xuất
                </a>
            </div>

        </aside>


        <!-- Nội dung chính -->
        <main class="main-content tenants-content">

            <div class="page-header tenants-header">
                <div>
                    <h1>Quản lý người thuê</h1>
                    <p>Danh sách người thuê và thông tin hợp đồng</p>
                </div>

                <a href="/Landlord/ContractForm" class="add-tenant-button">
                    + Lập hợp đồng
                </a>
            </div>


            <!-- Thống kê người thuê -->
            <section class="tenant-statistics">

                <div class="tenant-stat-card">
                    <span class="stat-label total">Tổng số người thuê</span>
                    <h2>@(ViewBag.TotalTenants ?? 0)</h2>
                    <p>Đang thuê</p>
                </div>

                <div class="tenant-stat-card">
                    <span class="stat-label active">Đang hợp đồng</span>
                    <h2>@(ViewBag.ActiveContracts ?? 0)</h2>
                    <p>Còn hiệu lực</p>
                </div>

                <div class="tenant-stat-card">
                    <span class="stat-label expiring">Sắp hết hạn</span>
                    <h2>@(ViewBag.Expiring ?? 0)</h2>
                    <p>Trong 30 ngày</p>
                </div>

                <div class="tenant-stat-card">
                    <span class="stat-label expired">Đã hết hạn</span>
                    <h2>@(ViewBag.Expired ?? 0)</h2>
                    <p>Cần xử lý</p>
                </div>

            </section>


            <!-- Thanh tìm kiếm và bộ lọc -->
            <section class="tenant-toolbar">

                <div class="tenant-search">
                    <span class="search-icon"></span>
                    <input type="text"
                           id="tenantSearch"
                           placeholder="Tìm kiếm theo tên, số điện thoại, phòng..." />
                </div>

                <select id="roomFilter">
                    <option value="">Tất cả phòng</option>
                    @foreach (var r in rooms)
                    {
                        <option value="@r.RoomCode">@r.RoomCode</option>
                    }
                </select>

                <select id="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang thuê</option>
                    <option value="expiring">Sắp hết hạn</option>
                    <option value="expired">Đã hết hạn</option>
                </select>

                <button type="button" class="filter-button" id="filterButton">
                    <span class="filter-icon"></span>
                    Bộ lọc
                </button>

            </section>


            <!-- Bảng danh sách người thuê -->
            <section class="tenant-table-panel">

                <div class="table-wrapper">

                    <table class="tenant-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên người thuê</th>
                                <th>Số điện thoại</th>
                                <th>Phòng</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody id="tenantTableBody">
                            @if (Model != null && Model.Any())
                            {
                                int stt = 1;
                                foreach (var c in Model)
                                {
                                    var roomCode = c.Room?.RoomCode ?? "P" + c.RoomId;
                                    var isTerminated = c.Status == "TERMINATED";
                                    var isExpiring = c.Status == "ACTIVE" && c.EndDate.HasValue && c.EndDate.Value <= today.AddDays(30) && c.EndDate.Value >= today;
                                    var isExpired = c.Status == "EXPIRED" || (c.Status == "ACTIVE" && c.EndDate.HasValue && c.EndDate.Value < today);

                                    var statusKey = isTerminated ? "expired" : (isExpired ? "expired" : (isExpiring ? "expiring" : "active"));
                                    var statusLabel = isTerminated ? "Đã trả phòng" : (isExpired ? "Đã hết hạn" : (isExpiring ? "Sắp hết hạn" : "Đang thuê"));

                                    <tr data-room="@roomCode" data-status="@statusKey">
                                        <td>@(stt++)</td>
                                        <td><strong>@(c.Tenant?.FullName ?? "Chưa rõ")</strong></td>
                                        <td>@(c.Tenant?.PhoneNumber ?? "—")</td>
                                        <td>@roomCode</td>
                                        <td>@c.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>@(c.EndDate.HasValue ? c.EndDate.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")</td>
                                        <td>
                                            <span class="tenant-status @statusKey">@statusLabel</span>
                                        </td>
                                        <td>
                                            <a href="/Landlord/Invoices" style="font-size:11px; color:#176b5d; text-decoration:none; font-weight:600; margin-right:6px;">Hóa đơn</a>
                                            @if (c.Status == "ACTIVE")
                                            {
                                                <button type="button" 
                                                        class="btn-terminate-tenant"
                                                        data-contract-id="@c.Id"
                                                        data-room-code="@roomCode"
                                                        data-tenant-name="@(c.Tenant?.FullName ?? "người thuê")"
                                                        style="background:none; border:none; padding:0; font-size:11px; color:#dc3545; font-weight:600; cursor:pointer;">
                                                    Chấm dứt
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div class="tenant-empty" style="@(Model != null && Model.Any() ? "display:none;" : "display:flex;")">
                        Chưa có dữ liệu người thuê.
                    </div>

                </div>


                <!-- Phân trang -->
                <div class="table-pagination">

                    <span class="pagination-info">
                        Hiển thị danh sách người thuê
                    </span>

                    <div class="pagination-controls">

                        <button type="button" disabled>
                            &lt;
                        </button>

                        <button type="button" class="current-page">
                            1
                        </button>

                        <button type="button" disabled>
                            &gt;
                        </button>

                    </div>

                </div>

            </section>

        </main>

    </div>

    <script src="~/js/landlord-tenants.js"></script>

</body>
</html>
