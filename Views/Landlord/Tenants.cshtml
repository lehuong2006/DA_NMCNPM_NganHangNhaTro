@{
    Layout = null;
    ViewData["Title"] = "Quản lý người thuê";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/landlord-dashboard.css" />
    <link rel="stylesheet" href="~/css/landlord-tenants.css" />
</head>
<body>

    <div class="dashboard-layout">

        <!-- Thanh điều hướng -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>Ngân hàng nhà trọ</h2>
                <p>Nhà trọ số 8 Nguyễn An Ninh</p>
            </div>

            <nav class="sidebar-nav">

                <a href="/Landlord/Dashboard" class="nav-item">
                    <span></span>
                    Tổng quan
                </a>

                <a href="/Landlord/Rooms" class="nav-item">
                    <span></span>
                    Phòng
                </a>

                <a href="/Landlord/Tenants" class="nav-item active">
                    <span></span>
                    Người thuê
                </a>

                <a href="/Landlord/ContractForm" class="nav-item">
                    <span></span>
                    Hợp đồng
                </a>

                <a href="/Landlord/Invoices" class="nav-item">
                    <span></span>
                    Hóa đơn
                </a>

                <a href="/Landlord/WalletTransactions" class="nav-item">
                    <span></span>
                    Giao dịch ví
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-role">Chủ trọ</div>

                <a href="/Account/Login" class="logout-button">
                    <span></span>
                    Đăng xuất
                </a>
            </div>

        </aside>


        <!-- Nội dung chính -->
        <main class="main-content tenants-content">

            <div class="page-header tenants-header">
                <div>
                    <h1>
                        Quản lý người thuê
                    </h1>
                    <p>Danh sách người thuê và thông tin hợp đồng</p>
                </div>

                <a href="/Landlord/ContractForm" class="add-tenant-button">
                    Thêm người thuê
                </a>
            </div>


            <!-- Thống kê người thuê -->
            <section class="tenant-statistics">

                <div class="tenant-stat-card">
                    <span class="stat-label total">Tổng số người thuê</span>
                    <h2></h2>
                    <p>Đang thuê</p>
                </div>

                <div class="tenant-stat-card">
                    <span class="stat-label active">Đang hợp đồng</span>
                    <h2></h2>
                    <p>Còn hiệu lực</p>
                </div>

                <div class="tenant-stat-card">
                    <span class="stat-label expiring">Sắp hết hạn</span>
                    <h2></h2>
                    <p>Trong 30 ngày</p>
                </div>

                <div class="tenant-stat-card">
                    <span class="stat-label expired">Đã hết hạn</span>
                    <h2></h2>
                    <p>Cần xử lý</p>
                </div>

            </section>


            <!-- Thanh tìm kiếm và bộ lọc -->
            <section class="tenant-toolbar">

                <div class="tenant-search">
                    <span class="search-icon"></span>
                    <input type="text"
                           id="tenantSearch"
                           placeholder="Tìm kiếm theo tên, số điện thoại, phòng..." />
                </div>

                <select id="roomFilter">
                    <option value="">Tất cả phòng</option>
                </select>

                <select id="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang thuê</option>
                    <option value="expiring">Sắp hết hạn</option>
                    <option value="expired">Đã hết hạn</option>
                </select>

                <button type="button" class="filter-button" id="filterButton">
                    <span class="filter-icon"></span>
                    Bộ lọc
                </button>

            </section>


            <!-- Bảng danh sách người thuê -->
            <section class="tenant-table-panel">

                <div class="table-wrapper">

                    <table class="tenant-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên người thuê</th>
                                <th>Số điện thoại</th>
                                <th>Phòng</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody id="tenantTableBody">
                            <!-- Dữ liệu người thuê sẽ được tích hợp từ database -->
                        </tbody>
                    </table>

                    <div class="tenant-empty">
                        Chưa có dữ liệu người thuê.
                    </div>

                </div>


                <!-- Phân trang -->
                <div class="table-pagination">

                    <span class="pagination-info">
                        Hiển thị danh sách người thuê
                    </span>

                    <div class="pagination-controls">

                        <button type="button" disabled>
                            &lt;
                        </button>

                        <button type="button" class="current-page">
                            1
                        </button>

                        <button type="button" disabled>
                            &gt;
                        </button>

                    </div>

                </div>

            </section>

        </main>

    </div>

    <script src="~/js/landlord-tenants.js"></script>

</body>
</html>
