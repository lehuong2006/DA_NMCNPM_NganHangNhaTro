@{
    Layout = null;
    ViewData["Title"] = "Hợp đồng và Hóa đơn";
    var contract = ViewBag.Contract as BTL_NganHangNhaTro.Models.Contract;
    var invoices = ViewBag.Invoices as IEnumerable<BTL_NganHangNhaTro.Models.Invoice> ?? Enumerable.Empty<BTL_NganHangNhaTro.Models.Invoice>();
    var userFullName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Khách thuê";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/landlord-dashboard.css" />
    <link rel="stylesheet" href="~/css/tenant-contracts-invoices.css" />
    <style>
        .pay-btn-inline {
            background-color: #176b5d;
            color: #ffffff;
            border: none;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 11px;
            cursor: pointer;
            font-weight: 600;
        }
        .pay-btn-inline:hover {
            background-color: #105448;
        }
    </style>
</head>

<body>

    <div class="dashboard-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>Ngân hàng nhà trọ</h2>
                <p>Nhà trọ số 8 Nguyễn An Ninh</p>
            </div>

            <nav class="sidebar-nav">

                <a href="/Tenant/Dashboard" class="nav-item">
                    <span></span>
                    Trang Chủ
                </a>

                <a href="/Tenant/Wallet" class="nav-item">
                    <span></span>
                    Ví của tôi
                </a>

                <a href="/Tenant/ContractsAndInvoices" class="nav-item active">
                    <span></span>
                    Hợp đồng và Hóa đơn
                </a>

                <a href="/Tenant/TransactionHistory" class="nav-item">
                    <span></span>
                    Lịch sử giao dịch
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-role">@userFullName</div>

                <a href="/Account/Logout" class="logout-button">
                    <span></span>
                    Đăng xuất
                </a>
            </div>

        </aside>


        <!-- Nội dung chính -->
        <main class="main-content tenant-contract-content">

            <div class="contract-page-header">
                <h1>Hợp đồng &amp; hóa đơn</h1>
            </div>


            <!-- Thông tin hợp đồng -->
            <section class="contract-information-panel">

                <div class="contract-main-information">

                    <div class="contract-section-title">
                        <span class="contract-title-icon"></span>
                        <h2>Thông tin hợp đồng</h2>
                    </div>

                    <div class="contract-details-grid">

                        <div class="contract-detail-item">
                            <span class="detail-label">Mã hợp đồng</span>
                            <strong>@(contract != null ? "HD-" + contract.Id.ToString("D5") : "Chưa có")</strong>
                        </div>

                        <div class="contract-detail-item">
                            <span class="detail-label">Ngày bắt đầu</span>
                            <strong>@(contract != null ? contract.StartDate.ToString("dd/MM/yyyy") : "—")</strong>
                        </div>

                        <div class="contract-detail-item">
                            <span class="detail-label">Ngày kết thúc</span>
                            <strong>@(contract?.EndDate.HasValue == true ? contract.EndDate.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")</strong>
                        </div>

                        <div class="contract-detail-item">
                            <span class="detail-label">Phòng</span>
                            <strong>@(contract?.Room?.RoomCode ?? "Chưa xếp phòng")</strong>
                        </div>

                        <div class="contract-detail-item">
                            <span class="detail-label">Tiền đặt cọc</span>
                            <strong>@(contract != null ? contract.DepositAmount.ToString("N0") + " VNĐ" : "—")</strong>
                        </div>

                        <div class="contract-detail-item">
                            <span class="detail-label">Giá phòng</span>
                            <strong>@(contract != null ? contract.RentalPrice.ToString("N0") + " VNĐ/tháng" : "—")</strong>
                        </div>

                    </div>

                </div>


                <!-- Địa chỉ phòng -->
                <div class="room-address-card">

                    <div class="room-address-heading">
                        <span class="room-address-icon"></span>
                        <h3>Địa chỉ phòng</h3>
                    </div>

                    <strong class="room-address-number">@(contract?.Room?.RoomCode ?? "P...")</strong>

                    <p>Nhà trọ số 8 Nguyễn An Ninh</p>

                </div>

            </section>


            <!-- Danh sách hóa đơn -->
            <section class="tenant-invoices-panel">

                <div class="invoice-section-title">
                    <span class="invoice-title-icon"></span>
                    <h2>Danh Sách Hóa Đơn</h2>
                </div>


                <div class="tenant-invoices-table-wrapper">

                    <table class="tenant-invoices-table">

                        <thead>
                            <tr>
                                <th>Mã HĐ</th>
                                <th>Kỳ thanh toán</th>
                                <th>Tiền phòng</th>
                                <th>Tiền điện/nước/DV</th>
                                <th>Tổng cộng</th>
                                <th>Hạn thanh toán</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody id="tenantInvoicesTableBody">
                            @if (invoices.Any())
                            {
                                foreach (var inv in invoices)
                                {
                                    var otherFees = inv.ElecFee + inv.WaterFee + inv.ServiceFee;
                                    <tr>
                                        <td><strong>@inv.InvoiceCode</strong></td>
                                        <td>@inv.MonthYear</td>
                                        <td>@inv.RoomFee.ToString("N0") đ</td>
                                        <td>@otherFees.ToString("N0") đ</td>
                                        <td><strong>@inv.TotalAmount.ToString("N0") đ</strong></td>
                                        <td>@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                                        <td>
                                            <span class="invoice-status @inv.Status.ToLower()">
                                                @(inv.Status == "PAID" ? "Đã thanh toán" : "Chưa thanh toán")
                                            </span>
                                        </td>
                                        <td>
                                            @if (inv.Status != "PAID")
                                            {
                                                <button type="button" class="pay-btn-inline" onclick="payInvoice(@inv.Id, '@inv.InvoiceCode', @inv.RemainingAmount)">
                                                    Thanh toán ví
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="color:#237343; font-size:11px;">Hoàn tất</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>

                    <div class="tenant-invoices-empty" style="@(invoices.Any() ? "display:none;" : "")">
                        Chưa có hóa đơn.
                    </div>

                </div>

            </section>

        </main>

    </div>

    <script>
        async function payInvoice(invoiceId, code, amount) {
            if (!confirm(`Bạn có chắc chắn muốn thanh toán hóa đơn ${code} với số tiền ${amount.toLocaleString('vi-VN')} VNĐ từ số dư ví không?`)) {
                return;
            }

            try {
                const response = await fetch(`/Tenant/PayInvoice?invoiceId=${invoiceId}`, {
                    method: 'POST'
                });
                const res = await response.json();
                if (res.success) {
                    alert(res.message);
                    window.location.reload();
                } else {
                    alert(res.message);
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi kết nối khi thanh toán.");
            }
        }
    </script>

</body>
</html>
