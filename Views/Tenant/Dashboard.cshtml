@{
    Layout = null;
    ViewData["Title"] = "Trang chủ khách thuê";
    var contract = ViewBag.Contract as BTL_NganHangNhaTro.Models.Contract;
    var invoices = ViewBag.Invoices as IEnumerable<BTL_NganHangNhaTro.Models.Invoice> ?? Enumerable.Empty<BTL_NganHangNhaTro.Models.Invoice>();
    var currentInvoice = ViewBag.CurrentInvoice as BTL_NganHangNhaTro.Models.Invoice;
    var services = ViewBag.Services as IEnumerable<BTL_NganHangNhaTro.Models.ServicePrice> ?? Enumerable.Empty<BTL_NganHangNhaTro.Models.ServicePrice>();
    var userFullName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Khách thuê";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <!-- CSS Sidebar dùng chung -->
    <link rel="stylesheet" href="~/css/landlord-dashboard.css" />

    <!-- CSS riêng trang khách thuê -->
    <link rel="stylesheet" href="~/css/tenant-dashboard.css" />
</head>

<body>

    <div class="dashboard-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <h2>Ngân hàng nhà trọ</h2>
                <p>Nhà trọ số 8 Nguyễn An Ninh</p>
            </div>

            <nav class="sidebar-nav">

                <a href="/Tenant/Dashboard" class="nav-item active">
                    <span></span>
                    Trang Chủ
                </a>

                <a href="/Tenant/Wallet" class="nav-item">
                    <span></span>
                    Ví của tôi
                </a>

                <a href="/Tenant/ContractsAndInvoices" class="nav-item">
                    <span></span>
                    Hợp đồng và Hóa đơn
                </a>

                <a href="/Tenant/TransactionHistory" class="nav-item">
                    <span></span>
                    Lịch sử giao dịch
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-role">@userFullName</div>

                <a href="/Account/Logout" class="logout-button">
                    <span></span>
                    Đăng xuất
                </a>
            </div>

        </aside>


        <!-- Nội dung chính -->
        <main class="main-content tenant-content">

            <!-- Tiêu đề -->
            <div class="tenant-welcome">
                <h1>Xin chào, @userFullName</h1>
            </div>


            <!-- Thống kê tổng quan -->
            <section class="tenant-statistics">

                <div class="tenant-stat-card">

                    <div class="tenant-stat-heading">
                        <span class="tenant-stat-icon room-icon"></span>
                        <span>Phòng đang ở</span>
                    </div>

                    <h2>@(contract?.Room?.RoomCode ?? "Chưa thuê")</h2>
                    <p>@(contract != null ? contract.RentalPrice.ToString("N0") + " đ/tháng" : "Liên hệ chủ trọ")</p>

                </div>


                <div class="tenant-stat-card">

                    <div class="tenant-stat-heading">
                        <span class="tenant-stat-icon invoice-icon"></span>
                        <span>Hóa đơn tháng này</span>
                    </div>

                    <h2>@(currentInvoice != null ? currentInvoice.TotalAmount.ToString("N0") + " đ" : "0 đ")</h2>
                    <p>@(currentInvoice != null ? (currentInvoice.Status == "PAID" ? "Đã thanh toán" : "Chưa thanh toán") : "Chưa phát sinh")</p>

                </div>


                <div class="tenant-stat-card">

                    <div class="tenant-stat-heading">
                        <span class="tenant-stat-icon paid-icon"></span>
                        <span>Đã thanh toán</span>
                    </div>

                    <h2>@(((long)(ViewBag.TotalPaid ?? 0)).ToString("N0")) đ</h2>
                    <p>Tổng các kỳ</p>

                </div>


                <div class="tenant-stat-card">

                    <div class="tenant-stat-heading">
                        <span class="tenant-stat-icon service-icon"></span>
                        <span>Dịch vụ đang dùng</span>
                    </div>

                    <h2>@services.Count()</h2>
                    <p>Dịch vụ phòng</p>

                </div>

            </section>


            <!-- Khu vực nội dung -->
            <section class="tenant-dashboard-grid">

                <!-- Hóa đơn -->
                <div class="tenant-panel tenant-invoice-panel">

                    <div class="tenant-panel-header">
                        <div class="tenant-panel-title">
                            <span class="panel-icon invoice-panel-icon"></span>
                            <h3>Hóa Đơn Của Tôi</h3>
                        </div>
                    </div>


                    <div class="tenant-table-wrapper">

                        <table class="tenant-table">

                            <thead>
                                <tr>
                                    <th>Kỳ</th>
                                    <th>Mã HĐ</th>
                                    <th>Số tiền</th>
                                    <th>Hạn thanh toán</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (invoices.Any())
                                {
                                    foreach (var inv in invoices)
                                    {
                                        <tr>
                                            <td>@inv.MonthYear</td>
                                            <td>@inv.InvoiceCode</td>
                                            <td><strong>@inv.TotalAmount.ToString("N0") đ</strong></td>
                                            <td>@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                                            <td>
                                                <span class="invoice-status @inv.Status.ToLower()">
                                                    @(inv.Status == "PAID" ? "Đã thanh toán" : "Chưa thanh toán")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>

                        </table>

                        <div class="tenant-empty" style="@(invoices.Any() ? "display:none;" : "")">
                            Chưa có hóa đơn.
                        </div>

                    </div>


                    <div class="tenant-invoice-action">
                        <a href="/Tenant/ContractsAndInvoices" class="pay-invoice-button">
                            Xem chi tiết &amp; Thanh toán
                        </a>
                    </div>

                </div>


                <!-- Cột bên phải -->
                <div class="tenant-right-column">

                    <!-- Thao tác nhanh -->
                    <div class="tenant-panel quick-action-panel">

                        <div class="tenant-panel-title">
                            <h3>Thao tác nhanh</h3>
                        </div>

                        <div class="quick-action-list">

                            <a href="/Tenant/ContractsAndInvoices" class="tenant-shortcut-button primary">
                                Thanh toán hóa đơn
                            </a>

                            <a href="/Tenant/Wallet" class="tenant-shortcut-button">
                                Nạp tiền vào ví
                            </a>

                            <a href="/Tenant/TransactionHistory" class="tenant-shortcut-button">
                                Lịch sử giao dịch
                            </a>

                        </div>


                    </div>


                    <!-- Dịch vụ đang sử dụng -->
                    <div class="tenant-panel tenant-service-panel">

                        <div class="tenant-panel-title">
                            <span class="panel-icon service-panel-icon"></span>
                            <h3>Biểu phí dịch vụ</h3>
                        </div>

                        <div class="tenant-service-list">
                            @foreach (var s in services)
                            {
                                <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f0f4f2; font-size:12px;">
                                    <span>@s.ServiceName:</span>
                                    <strong>@s.UnitPrice.ToString("N0") đ / @s.Unit</strong>
                                </div>
                            }
                        </div>

                    </div>

                </div>

            </section>

        </main>

    </div>

    <script src="~/js/tenant-dashboard.js"></script>

</body>
</html>
